# src/server/static/ is the real frontend source — build:static (esbuild)
# compiles it into dist-static/. Everything else under src/ (server.ts,
# capabilities/, etc.) isn't used by the Vercel build, but excluding "src"
# wholesale also hid src/server/static from the upload, which silently kept
# Vercel building an ancient snapshot for weeks. Simplest correct fix: stop
# excluding src/ at all — it's source, not secrets, and this is a build-time
# ignore file, not a deploy-time content filter.
supabase
feedIA
tsconfig*.json
.githooks
.agents
.claude
# Keep frontend and API functions
!public/
!public/**
!api/
!api/**

# api/systems/** all import unguarded from ../../../src/services/*, which is
# excluded above. These functions are also unreachable in practice — the
# routes emitted by scripts/vercel-build.sh send every /api/* request to
# api/[...path] before Vercel's filesystem-routed function matching runs, and
# the equivalent 10 "rational systems" are served live by the Railway backend
# (see src/server.ts, GET /api/systems/health). Excluding them stops Vercel
# from trying (and failing) to bundle 22 functions with unresolvable imports.
api/systems
