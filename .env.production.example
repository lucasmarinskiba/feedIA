# FeedIA Production — 14 Rational Systems
# Copy to .env.production and fill values

# Server Config
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://feedia.vercel.app
LOG_LEVEL=info

# Database
SUPABASE_URL=https://<production>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=rediss://default:...@...upstash.io:6379
DATABASE_URL=postgresql://user:password@host:5432/feedia_prod

# Auth & Security
SESSION_SECRET=
JWT_SECRET=
CORS_ORIGIN=https://feedia.app

# AI & Content Generation
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=sk_live_
STRIPE_PUBLISHABLE_KEY=pk_live_

# Social Media Integrations (for Competitive Intelligence + Channel Orchestration)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_API_KEY=
PINTEREST_API_KEY=
FACEBOOK_PAGE_ID=
YOUTUBE_API_KEY=

# 14 Systems Feature Flags
ENABLE_CONTENT_CURATION=true
ENABLE_AUDIENCE_PROFILING=true
ENABLE_ENGAGEMENT_FORECASTING=true
ENABLE_AB_TESTING=true
ENABLE_CHANNEL_ORCHESTRATION=true
ENABLE_COMPETITIVE_INTELLIGENCE=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_COMPLIANCE_VALIDATOR=true
ENABLE_TREND_DETECTOR=true
ENABLE_GROWTH_HACKER=true
ENABLE_ROI_CALCULATOR=true
ENABLE_SMART_BATCHING=true
ENABLE_AUTO_FEEDBACK_LOOP=true
ENABLE_PLATFORM_NATIVE_OUTPUT=true

# Performance Tuning
MAX_REQUEST_SIZE=50mb
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=100
BATCH_SIZE=1000

# Monitoring & Logging
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=
DATADOG_API_KEY=
ADMIN_WEBHOOK_URL=
ALERT_EMAIL=lucasdmarin@gmail.com

# Deployment (choose one)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# RENDER_DEPLOY_HOOK_PROD=
# RAILWAY_TOKEN_PROD=
# FLY_API_TOKEN_PROD=

# Smoke Tests
OWNER_TEST_EMAIL=lucasdmarin@gmail.com
OWNER_TEST_PASSWORD=

# Cost Control (for ROI Calculator)
MONTHLY_BUDGET_CAP=1000
SPEND_ALERT_THRESHOLD_PERCENT=80

# Debug (keep false in production)
DEBUG=false
VERBOSE_LOGGING=false
MOCK_EXTERNAL_APIS=false
