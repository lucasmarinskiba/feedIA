# Temporary eslint ignore for non-critical files
# These will be refactored incrementally

# Agents & workers (not in main API path)
src/agent/**/*.ts
src/agents/**/*.ts
src/workers/**/*.ts
src/skills/**/*.ts

# Testing files
src/__tests__/**/*.ts

# Services (non-critical)
src/services/brand*.ts
src/services/content*.ts
src/services/personality*.ts

# Utils & helpers
src/utils/**/*.ts
src/lib/**/*.ts

# Config
src/config/**/*.ts

# Only lint: API routes and core business logic
# src/api/**/*.ts - KEEP (critical)
# src/server/**/*.ts - KEEP (critical)
# src/db/**/*.ts - KEEP (critical)
